BALLAST_SERVER_BIND=0.0.0.0:8080
BALLAST_GATEWAY_BIND=0.0.0.0:50051
BALLAST_GATEWAY_ENDPOINT=http://gateway:50051
DATABASE_URL=postgres://ballast:ballast@postgres:5432/ballast
RUST_LOG=ballast_server=info,tower_http=info
LOG_LEVEL=info
BALLAST_CORS_ORIGIN=http://localhost:5173
BALLAST_PUBLIC_ORIGIN=http://localhost:8080
BALLAST_WEB_PORT=8080
BALLAST_LIVE_ENABLED=false
BALLAST_PRIVATE_RECONCILIATION_ENABLED=false
# OIDC：ISSUER + AUDIENCE 启用 API 鉴权，ISSUER + CLIENT_ID 启用 Web PKCE 登录。
# 部署 Web UI 时三者应同时设置；全部留空则纸面 API 保持开放。
# live 仍需对账与风控完成后才会允许 BALLAST_LIVE_ENABLED=true。
BALLAST_OIDC_ISSUER=
BALLAST_OIDC_AUDIENCE=
BALLAST_OIDC_CLIENT_ID=
# JWT 中的角色声明（字符串数组或空格/逗号分隔）；取值 viewer|operator|admin
BALLAST_OIDC_ROLE_CLAIM=ballast_roles
BALLAST_OIDC_CLOCK_SKEW_SECS=60
POSTGRES_PASSWORD=change-this-for-shared-environments
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# 交易所下单凭证和真实密钥值不得加入本文件或提交到仓库。

# Docker Hub 预构建镜像（deploy/compose.yaml 只 pull，不在服务器编译）
# Tag：latest=最新正式发版；生产建议固定到 X.Y.Z 或 sha-<short>
BALLAST_IMAGE_NAMESPACE=sevenold
BALLAST_IMAGE_TAG=latest
