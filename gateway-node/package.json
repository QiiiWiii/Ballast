{
  "name": "@ballast/exchange-gateway",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:proto": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --outDir=src/generated ../proto/exchange_gateway.proto ../proto/private_gateway.proto",
    "build": "npm run generate:proto && tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "dev": "tsx watch src/index.ts",
    "private-smoke": "node dist/private-readonly-smoke.js",
    "start": "node dist/index.js",
    "test": "node --test dist/*.test.js dist/private/*.test.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "ccxt": "4.5.58",
    "decimal.js": "^10.6.0",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "license": "Apache-2.0"
}
